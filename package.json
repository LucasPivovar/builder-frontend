{
  "name": "visual-builder-vue",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n FRONTEND,API -c cyan,blue \"npm run serve\" \"npm run api:dev\"",
    "serve": "vue-cli-service serve",
    "api": "npm --prefix ../builder-backend run start",
    "api:dev": "npm --prefix ../builder-backend run start:dev",
    "api:build": "npm --prefix ../builder-backend run build",
    "api:test": "npm --prefix ../builder-backend run test:e2e",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "bootstrap-icons": "^1.11.3",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "no-unused-vars": "warn"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
