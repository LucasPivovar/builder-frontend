{
  "name": "visual-builder-vue",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n FRONTEND,API -c cyan,blue \"npm run serve\" \"npm run api:dev\"",
    "serve": "vite",
    "api": "npm --prefix ../builder-backend run start",
    "api:dev": "npm --prefix ../builder-backend run start:dev",
    "api:build": "npm --prefix ../builder-backend run build",
    "api:test": "npm --prefix ../builder-backend run test:e2e",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue"
    ,"test": "vitest run"
  },
  "dependencies": {
    "bootstrap-icons": "^1.11.3",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "no-unused-vars": "warn"
    }
  }
}
