# URL da API do Builder Backend
# Em producao no mesmo dominio com proxy reverso (ex: Nginx redirecionando /api para a porta do backend):
# VITE_API_URL=/api
#
# Se a API estiver hospedada em dominio separado:
# VITE_API_URL=https://api.seudominio.com/api
#
# Em desenvolvimento local (padrao automatico se omitido):
# VITE_API_URL=http://127.0.0.1:3000/api
